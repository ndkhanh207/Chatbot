{
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/out/**": true,
        "**/target/**": true,
        "**/node_modules/**": true,
        "**/.next/**": true,
        "**/dist/**": true,
        "**/coverage/**": true,
        "**/.dart_tool/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.cache/**": true,
        "**/logs/**": true
    },
    "search.exclude": {
        "**/.gradle": true,
        "**/build": true,
        "**/out": true,
        "**/target": true,
        "**/node_modules": true,
        "**/.next": true,
        "**/dist": true,
        "**/coverage": true,
        "**/.dart_tool": true,
        "**/.venv": true,
        "**/__pycache__": true,
        "**/.cache": true,
        "**/logs": true
    },
    "search.followSymlinks": false
}